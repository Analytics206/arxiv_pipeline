# Database connections
MONGO_CONNECTION_STRING=mongodb://localhost:27017/
NEO4J_URL=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
QDRANT_URL=http://localhost:6333

# ArXiv API settings
ARXIV_MAX_RESULTS=100
ARXIV_RATE_LIMIT=3

# Exact arXiv category tokens retained by Kaggle cleanup and used by the
# bounded research-processing selector. Keep this as the single category list.
KAGGLE_RETAINED_CATEGORIES=cs.AI,cs.CV,cs.DB,cs.DS,cs.LG,cs.MA,cs.NE,cs.RO,cs.SE
