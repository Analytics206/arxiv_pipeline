# Shared ai-services connection for commands run from Windows.
# Use a LAN hostname or stable Tailscale name instead of localhost when the
# ai-services Ollama container runs on another computer.
AI_SERVICES_HOST=localhost
AI_SERVICES_OLLAMA_PORT=11434

# Containers on this computer reach published host ports through this name.
# Set it to the same LAN/Tailscale hostname when ai-services is remote.
AI_SERVICES_DOCKER_HOST=host.docker.internal

# Per-project model choice. The model itself is stored by ai-services.
OLLAMA_MODEL=qwen3.5:4b

# Dense model shared by the complementary evidence and discovery collections.
OLLAMA_EMBEDDING_MODEL=mxbai-embed-large:latest
QDRANT_RESEARCH_COLLECTION=research_knowledge_hybrid_v1
QDRANT_DISCOVERY_ALIAS=arxiv_discovery_current

# Append-only search traces used for retrieval evaluation and the future
# paper/idea feedback loop. These collections live in MONGO_DB.
RESEARCH_SEARCH_HISTORY_ENABLED=true
MONGO_SEARCH_RUNS_COLLECTION=research_search_runs
MONGO_SEARCH_PULLS_COLLECTION=research_search_source_pulls
MONGO_SEARCH_OUTPUTS_COLLECTION=research_search_outputs

# Portable default. Relative paths resolve from the project root on the host
# and from /app inside project containers.
PDF_STORAGE_DIR=data/pdfs

# Publish the read-only research API and human UI on every network interface so
# another computer on the same trusted LAN can use them. Set either bind value
# to 127.0.0.1 to make that service local-only.
RESEARCH_API_BIND=0.0.0.0
RESEARCH_API_PORT=8000
RESEARCH_MCP_BIND=0.0.0.0
RESEARCH_MCP_PORT=8001
RESEARCH_MCP_API_TIMEOUT=30
RESEARCH_UI_BIND=0.0.0.0
RESEARCH_UI_PORT=3000

# Browser origins allowed to read the API. "*" is convenient on a trusted
# private LAN; use a comma-separated allowlist if the network is less trusted.
CORS_ALLOWED_ORIGINS=*

# Historical mutation/debug endpoints stay off on the LAN service.
ENABLE_LEGACY_CYPHER_API=false
ENABLE_LEGACY_MUTATION_API=false

# Optional full native Ollama URL override. When set, it takes precedence over
# AI_SERVICES_HOST and AI_SERVICES_OLLAMA_PORT.
# OLLAMA_URL=http://gpu-box:11434

# Required by the post-import Kaggle cleanup. Use comma-separated exact arXiv
# category tokens; keep the actual production list in .env only.
KAGGLE_RETAINED_CATEGORIES=
